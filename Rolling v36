    Btn.Position = UDim2.new(0, 0, 0, 16)
    Btn.BackgroundColor3 = Color3.fromRGB(22, 22, 32)
    Btn.Text = ""
    Btn.AutoButtonColor = false
    Btn.Parent = Container
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)
    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(55, 50, 85)
    Stroke.Parent = Btn

    local BtnText = Instance.new("TextLabel")
    BtnText.Size = UDim2.new(1, -30, 1, 0)
    BtnText.Position = UDim2.new(0, 10, 0, 0)
    BtnText.BackgroundTransparency = 1
    BtnText.Text = placeholder
    BtnText.TextColor3 = Color3.fromRGB(160, 150, 180)
    BtnText.Font = Enum.Font.Gotham
    BtnText.TextSize = 11
    BtnText.TextXAlignment = Enum.TextXAlignment.Left
    BtnText.Parent = Btn

    local Arrow = Instance.new("TextLabel")
    Arrow.Size = UDim2.new(0, 20, 1, 0)
    Arrow.Position = UDim2.new(1, -25, 0, 0)
    Arrow.BackgroundTransparency = 1
    Arrow.Text = "v" 
    Arrow.TextColor3 = Color3.fromRGB(130, 110, 190)
    Arrow.Font = Enum.Font.GothamBold
    Arrow.TextSize = 12
    Arrow.Parent = Btn

    local Panel = Instance.new("ScrollingFrame")
    Panel.Size = UDim2.new(0, 276, 0, 150)
    Panel.BackgroundColor3 = Color3.fromRGB(16, 16, 24)
    Panel.BorderSizePixel = 0
    Panel.ZIndex = 100
    Panel.Visible = false
    Panel.ScrollBarThickness = 3
    Panel.ScrollBarImageColor3 = Color3.fromRGB(90, 70, 150)
    Panel.Parent = GUI
    Instance.new("UICorner", Panel).CornerRadius = UDim.new(0, 6)
    local PanelStroke = Instance.new("UIStroke")
    PanelStroke.Color = Color3.fromRGB(90, 70, 150)
    PanelStroke.Parent = Panel

    local PLayout = Instance.new("UIListLayout")
    PLayout.SortOrder = Enum.SortOrder.LayoutOrder
    PLayout.Parent = Panel

    local itemCount = 0
    local function AddItem(name, color, isHeader)
        local itemBtn = Instance.new("TextButton")
        itemBtn.Size = UDim2.new(1, 0, 0, 24)
        itemBtn.BackgroundTransparency = isHeader and 0.5 or 1
        itemBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
        itemBtn.Text = isHeader and ("  " .. name) or ("     " .. name)
        itemBtn.TextColor3 = color
        itemBtn.Font = isHeader and Enum.Font.GothamBold or Enum.Font.Gotham
        itemBtn.TextSize = isHeader and 10 or 11
        itemBtn.TextXAlignment = Enum.TextXAlignment.Left
        itemBtn.ZIndex = 101
        itemBtn.LayoutOrder = itemCount
        itemBtn.AutoButtonColor = false
        itemBtn.Parent = Panel
        itemCount = itemCount + 1

        if not isHeader then
            itemBtn.MouseEnter:Connect(function() itemBtn.BackgroundTransparency = 0.8 end)
            itemBtn.MouseLeave:Connect(function() itemBtn.BackgroundTransparency = 1 end)
            itemBtn.MouseButton1Click:Connect(function()
                if name == "Bỏ chọn" then
                    selectedValue = nil
                    BtnText.Text = placeholder
                    BtnText.TextColor3 = Color3.fromRGB(160, 150, 180)
                else
                    selectedValue = name
                    BtnText.Text = name
                    BtnText.TextColor3 = color
                end
                Panel.Visible = false
                activeDropdownPanel = nil
                onChangeCallback(selectedValue)
            end)
        end
    end

    AddItem("Bỏ chọn", Color3.fromRGB(255, 90, 90), false)
    for _, rarity in ipairs(RarityOrder) do
        if dataTable[rarity] then
            AddItem("- " .. rarity .. " -", Color3.fromRGB(110, 100, 140), true)
            for _, name in ipairs(dataTable[rarity]) do
                AddItem(name, RarityColor[rarity], false)
            end
        end
    end
    Panel.CanvasSize = UDim2.new(0, 0, 0, itemCount * 24)

    Btn.MouseButton1Click:Connect(function()
        if activeDropdownPanel and activeDropdownPanel ~= Panel then
            activeDropdownPanel.Visible = false
        end
        if Panel.Visible then
            Panel.Visible = false
            activeDropdownPanel = nil
        else
            local absPos = Btn.AbsolutePosition
            Panel.Position = UDim2.new(0, absPos.X, 0, absPos.Y + Btn.AbsoluteSize.Y + 4)
            Panel.Visible = true
            activeDropdownPanel = Panel
        end
    end)

    return Container
end

